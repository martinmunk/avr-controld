# Cross-compile ALSA AVR plugin for ARM64 (Alpine/musl compatible)
FROM --platform=linux/amd64 alpine:3.19

# Install cross-compilation tools
RUN apk add --no-cache \
    build-base \
    cmake \
    wget \
    tar \
    xz

# Download and install aarch64-linux-musl cross compiler
RUN cd /tmp && \
    wget https://musl.cc/aarch64-linux-musl-cross.tgz && \
    tar -xzf aarch64-linux-musl-cross.tgz -C /opt && \
    rm aarch64-linux-musl-cross.tgz

# Download and extract ARM64 Alpine packages for ALSA
RUN mkdir -p /opt/aarch64-sysroot/usr/lib /opt/aarch64-sysroot/usr/include && \
    cd /tmp && \
    # Download alsa-lib for aarch64
    wget https://dl-cdn.alpinelinux.org/alpine/v3.19/main/aarch64/alsa-lib-1.2.10-r0.apk && \
    wget https://dl-cdn.alpinelinux.org/alpine/v3.19/main/aarch64/alsa-lib-dev-1.2.10-r0.apk && \
    # Extract packages (apk files are just tar.gz)
    tar -xzf alsa-lib-1.2.10-r0.apk -C /opt/aarch64-sysroot && \
    tar -xzf alsa-lib-dev-1.2.10-r0.apk -C /opt/aarch64-sysroot && \
    # Cleanup
    rm -f *.apk

# Set up cross-compilation environment
ENV PATH="/opt/aarch64-linux-musl-cross/bin:${PATH}" \
    CC=aarch64-linux-musl-gcc \
    CXX=aarch64-linux-musl-g++ \
    CMAKE_SYSTEM_NAME=Linux \
    CMAKE_SYSTEM_PROCESSOR=aarch64

WORKDIR /build

# Copy source files
COPY include /build/include
COPY src /build/src
COPY CMakeLists.txt /build/

# Build the plugin
RUN mkdir -p build && cd build && \
    cmake \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
        -DCMAKE_C_COMPILER=aarch64-linux-musl-gcc \
        -DCMAKE_CXX_COMPILER=aarch64-linux-musl-g++ \
        -DCMAKE_FIND_ROOT_PATH=/opt/aarch64-sysroot \
        -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
        -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
        -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
        -DCMAKE_CXX_FLAGS="-I/opt/aarch64-sysroot/usr/include" \
        -DCMAKE_C_FLAGS="-I/opt/aarch64-sysroot/usr/include" \
        -DCMAKE_EXE_LINKER_FLAGS="-L/opt/aarch64-sysroot/usr/lib" \
        -DBUILD_TESTS=OFF \
        .. && \
    make -j$(nproc) VERBOSE=1

# Extract all built libraries and tools
CMD ["sh", "-c", "cp /build/build/libasound_module_ctl_*.so /build/build/avr-power /output/"]
