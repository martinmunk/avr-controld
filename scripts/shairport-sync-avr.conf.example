// Shairport-sync configuration snippet for AVR power management
// Add this to your /etc/shairport-sync.conf

sessioncontrol = {
    // Timeout before entering idle (standby) state
    // Set to 0 for immediate standby, or higher for grace period
    active_state_timeout = 30.0;  // 30 seconds after play stops

    // Power ON the receiver when playback starts
    run_this_before_entering_active_state = "/usr/local/bin/avr-power-on.sh";

    // Power OFF (standby) the receiver after idle timeout
    run_this_after_exiting_active_state = "/usr/local/bin/avr-power-off.sh";
};

// Alternative: Use immediate hooks (no timeout)
// sessioncontrol = {
//     run_this_before_play_begins = "/usr/local/bin/avr-power-on.sh";
//     run_this_after_play_ends = "/usr/local/bin/avr-power-off.sh";
// };
