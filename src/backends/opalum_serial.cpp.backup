#include "../../include/backend.hpp"
#include "../../include/logger.hpp"
#include "../../include/shared_state.hpp"
#include <fcntl.h>
#include <termios.h>
#include <unistd.h>
#include <cstring>
#include <ctime>
#include <sstream>
#include <iomanip>

namespace AlsaAVR {

class OpalumSerialBackend : public Backend {
private:
    int fd_ = -1;
    std::string device_;
    std::string input_;
    int current_volume_ = -1;
    bool current_mute_ = false;
    bool connected_ = false;
    time_t last_input_switch_ = 0;
    bool external_fd_ = false;  // Track if fd is from pool
    bool use_shared_state_ = false;  // Track if we use shared state for input switching
    Logger logger_;

    // Opalum volume is 0x00-0x63 (0-99 decimal, 100 steps)
    static constexpr int OPALUM_MAX_VOLUME = 0x63;

    bool send_command(const std::string& cmd) {
        if (fd_ < 0) {
            logger_.error("Cannot send command, device not connected");
            return false;
        }

        std::string full_cmd = cmd + "\r";
        ssize_t written = write(fd_, full_cmd.c_str(), full_cmd.length());
        if (written != static_cast<ssize_t>(full_cmd.length())) {
            logger_.error("Failed to send command: " + cmd);
            return false;
        }

        logger_.debug("Sent command: " + cmd);

        // Wait for response (OK or ER)
        // Opalum can be slow to respond, especially after power-on
        char response[16] = {0};
        int attempts = 0;
        ssize_t total_read = 0;

        // Try reading for up to 500ms
        while (attempts < 10 && total_read < static_cast<ssize_t>(sizeof(response) - 1)) {
            usleep(50000); // 50ms between attempts
            ssize_t n = read(fd_, response + total_read, sizeof(response) - total_read - 1);
            if (n > 0) {
                total_read += n;
                response[total_read] = '\0';
                // Check if we have a complete response
                if (strstr(response, "OK") || strstr(response, "ER")) {
                    break;
                }
            }
            attempts++;
        }

        if (total_read <= 0) {
            logger_.warn("No response from device for command: " + cmd);
            return false;
        }

        // Opalum responds with either "OK", "ER", or echoes the command back
        // Treating command echo as success (device confirms by echoing)
        bool has_ok = (strstr(response, "OK") != nullptr);
        bool has_error = (strstr(response, "ER") != nullptr);
        bool has_echo = (strstr(response, cmd.c_str()) != nullptr);

        bool success = (has_ok || has_echo) && !has_error;

        if (!success) {
            logger_.error("Command failed: " + cmd + " (response: " + std::string(response) + ")");
        } else {
            logger_.debug("Command succeeded: " + cmd + " (response: " + std::string(response) + ")");
        }
        return success;
    }

    void switch_input_if_needed() {
        if (input_.empty()) return;

        // Use shared state if available (plugin-level pooling)
        if (use_shared_state_) {
            if (SharedState::should_switch_input_serial(device_, input_, 10)) {
                logger_.info("Switching input to: " + input_);
                if (send_command("src" + input_)) {
                    SharedState::record_input_switch_serial(device_, input_);
                    usleep(100000); // Wait 100ms for input switch
                } else {
                    logger_.error("Failed to switch input to " + input_);
                }
            } else {
                logger_.debug("Skipping input switch (recently switched)");
            }
        } else {
            // Fallback to local state (for standalone backends)
            time_t now = time(nullptr);
            if (now - last_input_switch_ >= 10) {
                logger_.info("Switching input to: " + input_);
                if (send_command("src" + input_)) {
                    last_input_switch_ = now;
                    usleep(100000); // Wait 100ms for input switch
                } else {
                    logger_.error("Failed to switch input to " + input_);
                }
            } else {
                logger_.debug("Skipping input switch (recently switched)");
            }
        }
    }

    bool open_serial() {
        fd_ = open(device_.c_str(), O_RDWR | O_NOCTTY | O_SYNC);
        if (fd_ < 0) {
            return false;
        }

        struct termios tty;
        if (tcgetattr(fd_, &tty) != 0) {
            ::close(fd_);
            fd_ = -1;
            return false;
        }

        // Set 115200 baud, 8N1
        cfsetospeed(&tty, B115200);
        cfsetispeed(&tty, B115200);

        tty.c_cflag = (tty.c_cflag & ~CSIZE) | CS8;  // 8-bit chars
        tty.c_iflag &= ~IGNBRK;                       // disable break processing
        tty.c_lflag = 0;                              // no signaling chars, no echo, no canonical processing
        tty.c_oflag = 0;                              // no remapping, no delays
        tty.c_cc[VMIN]  = 0;                          // non-blocking read
        tty.c_cc[VTIME] = 5;                          // 0.5 seconds read timeout

        tty.c_iflag &= ~(IXON | IXOFF | IXANY);       // shut off xon/xoff ctrl
        tty.c_cflag |= (CLOCAL | CREAD);              // ignore modem controls, enable reading
        tty.c_cflag &= ~(PARENB | PARODD);            // no parity
        tty.c_cflag &= ~CSTOPB;                       // 1 stop bit
        tty.c_cflag &= ~CRTSCTS;                      // no flow control

        if (tcsetattr(fd_, TCSANOW, &tty) != 0) {
            ::close(fd_);
            fd_ = -1;
            return false;
        }

        // Flush any stale data in buffers
        tcflush(fd_, TCIOFLUSH);

        return true;
    }

public:
    bool init(const std::map<std::string, std::string>& config) override {
        // Initialize logger first
        auto log_file_it = config.find("log_file");
        auto log_level_it = config.find("log_level");
        std::string log_file = log_file_it != config.end() ? log_file_it->second : "";
        std::string log_level = log_level_it != config.end() ? log_level_it->second : "INFO";
        logger_.init(log_file, log_level);

        logger_.debug("Initializing Opalum RS232 backend");

        auto it = config.find("device");
        if (it == config.end()) {
            logger_.error("No device specified in configuration");
            return false;
        }
        device_ = it->second;
        logger_.debug("Device: " + device_);

        auto input_it = config.find("input");
        if (input_it != config.end()) {
            input_ = input_it->second;
            logger_.debug("Auto-switch input: " + input_);
        }

        // Check for shared state flag (for input switching coordination)
        auto shared_state_it = config.find("_use_shared_state");
        if (shared_state_it != config.end() && shared_state_it->second == "true") {
            use_shared_state_ = true;
            logger_.debug("Using shared state for input switching");
        }

        // Check for pooled file descriptor from connection pool
        auto fd_it = config.find("_pooled_fd");
        if (fd_it != config.end()) {
            try {
                fd_ = std::stoi(fd_it->second);
                external_fd_ = true;
                connected_ = (fd_ >= 0);
                if (connected_) {
                    logger_.debug("Using pooled serial port (fd=" + std::to_string(fd_) + ")");
                    return true;
                }
            } catch (const std::exception& e) {
                logger_.error("Invalid pooled fd value: " + fd_it->second);
                return false;
            }
        }

        if (!open_serial()) {
            logger_.error("Failed to open serial device");
            return false;
        }

        // Try to power on the device (may already be on)
        if (!send_command("pwr1")) {
            logger_.warn("Power-on command did not receive OK response (device may already be on)");
            // Don't fail - device might already be powered on
        } else {
            logger_.info("Device powered on successfully");
        }

        logger_.info("Connected to Opalum device at " + device_);
        connected_ = true;
        return true;
    }

    void close() override {
        if (fd_ >= 0 && !external_fd_) {
            // Only close fd if we created it ourselves
            logger_.debug("Closing self-managed serial port");
            ::close(fd_);
            fd_ = -1;
            logger_.info("Opalum device disconnected");
        } else if (external_fd_) {
            logger_.debug("Releasing pooled serial port (kept alive)");
        }
        connected_ = false;
    }

    BackendCaps capabilities() const override {
        return {
            .supports_absolute = true,
            .supports_query = false,  // No query command in protocol
            .supports_mute = false,   // Implemented via vol00
            .supports_input_select = true,
            .supports_speaker_level = false,
            .min_volume = 0,
            .max_volume = 100
        };
    }

    bool set_volume_absolute(int level) override {
        if (level < 0 || level > 100) {
            logger_.error("Invalid volume level: " + std::to_string(level));
            return false;
        }

        // Switch to configured input if needed (with cooldown)
        switch_input_if_needed();

        // Convert 0-100 to 0x00-0x63
        int opalum_vol = (level * OPALUM_MAX_VOLUME) / 100;

        std::ostringstream cmd;
        cmd << "vol" << std::hex << std::setw(2) << std::setfill('0') << opalum_vol;

        logger_.debug("Setting volume to " + std::to_string(level) + " (Opalum: 0x" +
                     std::to_string(opalum_vol) + ")");

        if (send_command(cmd.str())) {
            current_volume_ = level;
            logger_.info("Volume set to " + std::to_string(level));
            return true;
        }
        logger_.error("Failed to set volume to " + std::to_string(level));
        return false;
    }

    bool volume_up() override {
        logger_.debug("Increasing volume");
        if (send_command("vol+")) {
            if (current_volume_ < 100) current_volume_++;
            logger_.info("Volume increased to " + std::to_string(current_volume_));
            return true;
        }
        logger_.error("Failed to increase volume");
        return false;
    }

    bool volume_down() override {
        logger_.debug("Decreasing volume");
        if (send_command("vol-")) {
            if (current_volume_ > 0) current_volume_--;
            logger_.info("Volume decreased to " + std::to_string(current_volume_));
            return true;
        }
        logger_.error("Failed to decrease volume");
        return false;
    }

    int get_volume() override {
        return current_volume_;
    }

    bool set_mute(bool muted) override {
        // Switch to configured input if needed (with cooldown)
        switch_input_if_needed();

        logger_.debug("Setting mute to " + std::string(muted ? "true" : "false"));
        // Opalum doesn't have explicit mute, use vol00 for mute
        if (muted && current_volume_ > 0) {
            // Store current volume before muting
            logger_.info("Muting by setting volume to 0");
            return set_volume_absolute(0);
        }
        current_mute_ = muted;
        logger_.info("Mute state changed to " + std::string(muted ? "muted" : "unmuted"));
        return true;
    }

    bool get_mute() override {
        return current_mute_;
    }

    bool set_power(bool on) override {
        logger_.info("Setting power " + std::string(on ? "on" : "off"));
        bool result = send_command(on ? "pwr1" : "pwr0");
        if (result) {
            logger_.info("Power successfully set " + std::string(on ? "on" : "off"));
        } else {
            logger_.error("Failed to set power " + std::string(on ? "on" : "off"));
        }
        return result;
    }

    std::string name() const override {
        return "Opalum RS232";
    }

    bool is_connected() const override {
        return connected_ && fd_ >= 0;
    }

    std::vector<std::string> get_available_inputs() override {
        // Opalum has 6 inputs (0-5) as per the system integrators guide
        return {"Toslink1", "Toslink2", "Coaxial", "Bluetooth", "Analog", "Mixer"};
    }

    bool set_input(const std::string& input) override {
        // Map input names to numeric values
        std::map<std::string, std::string> input_map = {
            {"Toslink1", "0"},
            {"Toslink2", "1"},
            {"Coaxial", "2"},
            {"Bluetooth", "3"},
            {"Analog", "4"},
            {"Mixer", "5"}
        };

        std::string input_num;
        auto it = input_map.find(input);
        if (it != input_map.end()) {
            input_num = it->second;
        } else {
            // Fallback: allow direct numeric input
            input_num = input;
        }

        logger_.info("Setting input to: " + input + " (" + input_num + ")");
        if (send_command("src" + input_num)) {
            input_ = input_num;
            if (use_shared_state_) {
                SharedState::record_input_switch_serial(device_, input_num);
            } else {
                last_input_switch_ = time(nullptr);
            }
            usleep(100000); // Wait 100ms for input switch
            return true;
        }
        return false;
    }

    std::string get_current_input() override {
        if (input_.empty()) return "";

        // Map numeric values back to names
        std::map<std::string, std::string> reverse_map = {
            {"0", "Toslink1"},
            {"1", "Toslink2"},
            {"2", "Coaxial"},
            {"3", "Bluetooth"},
            {"4", "Analog"},
            {"5", "Mixer"}
        };

        auto it = reverse_map.find(input_);
        if (it != reverse_map.end()) {
            return it->second;
        }
        return input_;  // Fallback to numeric value
    }

    bool reconnect() override {
        logger_.info("Attempting to reconnect to Opalum device");
        close();
        usleep(500000); // Wait 500ms before reconnecting
        bool result = open_serial();
        if (result) {
            logger_.info("Successfully reconnected to Opalum device");
            connected_ = true;
        } else {
            logger_.error("Failed to reconnect to Opalum device");
        }
        return result;
    }
};

// Factory function
std::unique_ptr<Backend> create_opalum_serial_backend() {
    return std::make_unique<OpalumSerialBackend>();
}

} // namespace AlsaAVR
