# Custom shairport-sync image with AVR control plugin
FROM mikebrady/shairport-sync:latest

# Install build dependencies and ALSA utilities
RUN apk add --no-cache \
    build-base \
    cmake \
    alsa-lib-dev \
    alsa-lib \
    alsa-utils

# Copy source code
COPY include /tmp/alsa-avr/include
COPY src /tmp/alsa-avr/src
COPY CMakeLists.txt /tmp/alsa-avr/

# Build plugin for Alpine/musl
WORKDIR /tmp/alsa-avr
RUN mkdir -p build && cd build && \
    cmake -DBUILD_TESTS=OFF .. && \
    make -j4 && \
    mkdir -p /usr/lib/alsa-lib && \
    cp libasound_module_ctl_avr.so /usr/lib/alsa-lib/ && \
    cd / && rm -rf /tmp/alsa-avr

# Remove build-only dependencies to reduce image size
RUN apk del build-base cmake alsa-lib-dev

# Copy ALSA configuration
COPY docker-asound.conf /etc/asound.conf

WORKDIR /
