#!/bin/sh
# postinst for martinmunk-alsa-control-avr
set -e

case "$1" in
  configure)
    # The serial AVR backends (Opalum, NAD) talk to /dev/ttyUSB* which is
    # group 'dialout'. When shairport-sync drives the mixer, it runs as the
    # 'shairport-sync' service user (created by martinmunk-shairport-sync), so
    # that user needs to be in 'dialout'. dialout lives here, with the serial
    # plugins, rather than in the generic shairport-sync package (least
    # privilege: IP/CEC-only boxes don't need it). Guarded so it is a no-op
    # until/unless that user exists.
    if getent passwd shairport-sync >/dev/null 2>&1; then
      adduser shairport-sync dialout >/dev/null 2>&1 || true
    fi
    ;;
esac

#DEBHELPER#

exit 0
