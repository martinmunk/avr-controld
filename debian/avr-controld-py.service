[Unit]
Description=avr-controld -- AV receiver broker (socket API, optional Home Assistant MQTT)
Documentation=https://github.com/martinmunk/avr-controld
After=network-online.target
Wants=network-online.target

ConditionPathExists=/etc/avr-controld/config.conf

[Service]
Type=simple
ExecStart=/opt/avr-controld/bin/avr-controld --config /etc/avr-controld/config.conf
Restart=always
RestartSec=5
# Serial backends (NAD/Opalum) need /dev/ttyUSB* (group dialout).
SupplementaryGroups=dialout
# Optional: keep the MQTT password out of the config file.
# EnvironmentFile=-/etc/avr-controld/env

[Install]
WantedBy=multi-user.target
