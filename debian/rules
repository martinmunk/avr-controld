#!/usr/bin/make -f
export DH_VERBOSE=1
export PIP_BREAK_SYSTEM_PACKAGES=1
export PIP_DISABLE_PIP_VERSION_CHECK=1

PKG  := debian/martinmunk-avr-controld
ROOT := $(PKG)/opt/avr-controld
LIB  := $(ROOT)/lib

%:
	dh $@

# No virtualenv: a venv hard-codes one interpreter version (lib/python3.X,
# pyvenv.cfg), which forced "Depends: python3.13". Every runtime dependency is
# pure Python, so they are installed as a private library tree with
# `pip --target` and run by the system /usr/bin/python3 through a small
# launcher that puts that tree first on sys.path. The package then works on
# any python3 >= 3.11 (Debian bookworm/trixie, Ubuntu 24.04+, Raspberry Pi OS).
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	pip install --no-cache-dir --no-compile --target $(LIB) -r requirements-venv.txt
	pip install --no-cache-dir --no-compile --no-deps --target $(LIB) .
	# pip --target drops console-script stubs into lib/bin; the launcher replaces them.
	rm -rf $(LIB)/bin
	find $(LIB) -name '__pycache__' -type d -prune -exec rm -rf {} +
	install -D -m0755 debian/avr-controld.launcher $(ROOT)/bin/avr-controld
	install -D -m0644 examples/config.conf \
		$(PKG)/usr/share/doc/martinmunk-avr-controld/examples/config.conf

# Register the unit (daemon-reload) but do NOT enable/start: it needs an admin
# to create /etc/avr-controld/config.conf first.
override_dh_installsystemd:
	dh_installsystemd --name=avr-controld-py

override_dh_auto_clean:
	rm -rf build *.egg-info src/*.egg-info
	dh_auto_clean
