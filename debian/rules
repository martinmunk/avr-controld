#!/usr/bin/make -f
export DH_VERBOSE=1

VENV := /opt/avr-controld/venv
PKG  := debian/martinmunk-avr-controld

%:
	dh $@

# Pure-Python venv built at its final runtime path so shebangs/pyvenv.cfg are
# already correct -- no relocation needed. Built here (root in the CI container),
# cleaned in dh_auto_clean.
override_dh_auto_configure:

override_dh_auto_build:
	python3.13 -m venv $(VENV)
	$(VENV)/bin/pip install --no-cache-dir --upgrade pip
	$(VENV)/bin/pip install --no-cache-dir -r requirements-venv.txt
	$(VENV)/bin/pip install --no-cache-dir --no-deps .
	# Pin the interpreter symlinks to the concrete python3.13 (not the generic
	# /usr/bin/python3, which would follow a future default-python bump and break
	# the 3.13 venv). This makes `Depends: python3.13` correct and stable.
	ln -sf /usr/bin/python3.13 $(VENV)/bin/python3.13
	ln -sf python3.13 $(VENV)/bin/python3
	ln -sf python3.13 $(VENV)/bin/python

override_dh_auto_test:

override_dh_auto_install:
	mkdir -p $(PKG)/opt/avr-controld
	cp -a $(VENV) $(PKG)/opt/avr-controld/venv
	install -D -m0644 examples/config.conf \
		$(PKG)/usr/share/doc/martinmunk-avr-controld/examples/config.conf

# Register the unit (daemon-reload) but do NOT enable/start: it needs an admin
# to create /etc/avr-controld/config.conf first.
override_dh_installsystemd:
	dh_installsystemd --name=avr-controld-py

override_dh_auto_clean:
	rm -rf $(VENV) build *.egg-info src/*.egg-info
	dh_auto_clean
