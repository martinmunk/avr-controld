# ALSA configuration for CEC HDMI control (separate plugin)
# Place this in ~/.asoundrc or /etc/asound.conf

# ===== Option 1: Parameterized configuration with defaults (recommended) =====
# Supports environment variables and easy customization
ctl.cec {
    @args [ INITIAL_VOLUME LOG_FILE LOG_LEVEL ]
    @args.INITIAL_VOLUME {
        type string
        default {
            @func getenv
            vars [ CEC_INITIAL_VOLUME ]
            default "50"
        }
    }
    @args.LOG_FILE {
        type string
        default {
            @func getenv
            vars [ CEC_LOG_FILE ]
            default "/var/log/alsa-avr/cec.log"
        }
    }
    @args.LOG_LEVEL {
        type string
        default {
            @func getenv
            vars [ CEC_LOG_LEVEL ]
            default "INFO"
        }
    }
    type cec
    initial_volume $INITIAL_VOLUME
    log_file $LOG_FILE
    log_level $LOG_LEVEL
}

# Usage examples:
#   1. Use with environment variables:
#      CEC_INITIAL_VOLUME=75 amixer -D cec ...
#
#   2. Override volume inline (requires ALSA 1.2.4+):
#      amixer -D "cec:INITIAL_VOLUME=75" ...
#
#   3. Use defaults from config above:
#      amixer -D cec ...

# ===== Option 2: Fixed configuration =====
# Simple static configuration
ctl.cec_fixed {
    type cec
    initial_volume "50"                    # Optional: starting volume (0-100)
    log_file "/var/log/alsa-avr/cec.log"  # Optional
    log_level "INFO"                       # Optional: DEBUG, INFO, WARN, ERROR
}

# ===== Option 3: Multiple devices with different settings =====
# Define multiple CEC configurations with different initial volumes
ctl.cec_loud {
    type cec
    initial_volume "75"
}

ctl.cec_quiet {
    type cec
    initial_volume "25"
}

# Usage:
#   amixer -D cec_loud ...
#   amixer -D cec_quiet ...

# ===== Option 4: Set as default control =====
ctl.!default {
    type cec
    initial_volume "50"
}

# ===== PCM device with CEC control =====
# Audio output with AVR volume control
pcm.cec_audio {
    type hw
    card 0                                 # Your audio card
}

ctl.cec_audio {
    type cec
    initial_volume "50"
}

# ===== Complete asym setup (playback + AVR control) =====
# For applications like shairport-sync
pcm.cec_complete {
    type plug
    slave.pcm "hw:0"
}

ctl.cec_complete {
    type cec
    initial_volume "50"
}

# ===== OLD SYNTAX (unified plugin - for backwards compatibility) =====
# ctl.avr {
#     type avr
#     backend "cec"
#     initial_volume "50"
# }

# ===== Environment Variable Reference =====
# Set these before running ALSA commands:
#   export CEC_INITIAL_VOLUME=50
#   export CEC_LOG_FILE=/var/log/alsa-avr/cec.log
#   export CEC_LOG_LEVEL=DEBUG

# ===== CEC Notes =====
# - Requires cec-utils package: apt-get install cec-utils
# - Uses cec-client command-line tool
# - LIMITATION: No volume query support
#   * Plugin tracks volume internally
#   * If receiver volume changed externally (via remote), plugin won't know
#   * initial_volume sets starting point when plugin loads
# - LIMITATION: Toggle-only mute (no separate on/off)
# - Commands sent to audio system (CEC address 5)
# - Volume changes are incremental (volup/voldown commands)

# ===== CEC Setup =====
# Install CEC utilities:
#   sudo apt-get install cec-utils
#
# Test CEC connectivity:
#   echo "scan" | cec-client -s
#
# Check if audio system is detected:
#   echo "scan" | cec-client -s | grep -i audio
#
# Test volume control:
#   echo "volup" | cec-client -s
#   echo "voldown" | cec-client -s
#
# Test mute:
#   echo "mute" | cec-client -s
#
# Test power:
#   echo "on 5" | cec-client -s     # Turn on audio system
#   echo "standby 5" | cec-client -s  # Turn off audio system

# ===== Troubleshooting =====
# If CEC not working:
#   1. Check HDMI-CEC is enabled on your TV and audio system
#   2. Verify cec-client can see devices:
#      echo "scan" | cec-client -s
#   3. Check CEC adapter is detected:
#      ls -la /dev/cec*
#   4. Try restarting the CEC daemon:
#      sudo systemctl restart cec-client
#   5. Check ALSA plugin logs:
#      tail -f /var/log/alsa-avr/cec.log
