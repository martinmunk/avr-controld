# ALSA configuration for Opalum Serial control (separate plugin)
# Place this in ~/.asoundrc or /etc/asound.conf

# ===== Option 1: Parameterized configuration with defaults (recommended) =====
# Supports environment variables and easy customization
ctl.opalum {
    @args [ DEVICE INPUT LOG_FILE LOG_LEVEL ]
    @args.DEVICE {
        type string
        default {
            @func getenv
            vars [ OPALUM_DEVICE ]
            default "/dev/ttyUSB0"
        }
    }
    @args.INPUT {
        type string
        default {
            @func getenv
            vars [ OPALUM_INPUT ]
            default ""
        }
    }
    @args.LOG_FILE {
        type string
        default {
            @func getenv
            vars [ OPALUM_LOG_FILE ]
            default "/var/log/alsa-avr/opalum.log"
        }
    }
    @args.LOG_LEVEL {
        type string
        default {
            @func getenv
            vars [ OPALUM_LOG_LEVEL ]
            default "INFO"
        }
    }
    type opalum
    device $DEVICE
    input $INPUT
    log_file $LOG_FILE
    log_level $LOG_LEVEL
}

# Usage examples:
#   1. Use with environment variables:
#      OPALUM_DEVICE=/dev/ttyUSB1 amixer -D opalum ...
#
#   2. Override device inline (requires ALSA 1.2.4+):
#      amixer -D "opalum:DEVICE=/dev/ttyUSB1" ...
#
#   3. Use defaults from config above:
#      amixer -D opalum ...

# ===== Option 2: Fixed configuration =====
# Simple static configuration
ctl.opalum_fixed {
    type opalum
    device "/dev/ttyUSB0"
    input "1"                              # Optional: auto-switch input (0-4)
    log_file "/var/log/alsa-avr/opalum.log"  # Optional
    log_level "INFO"                       # Optional: DEBUG, INFO, WARN, ERROR
}

# ===== Option 3: Multiple amplifiers =====
# Define multiple amplifiers with different serial ports
ctl.opalum_workshop {
    type opalum
    device "/dev/ttyUSB0"
    input "1"
}

ctl.opalum_bedroom {
    type opalum
    device "/dev/ttyUSB1"
    input "2"
}

# Usage:
#   amixer -D opalum_workshop ...
#   amixer -D opalum_bedroom ...

# ===== Option 4: Set as default control =====
ctl.!default {
    type opalum
    device "/dev/ttyUSB0"
}

# ===== PCM device with Opalum control =====
# Audio output with AVR volume control
pcm.opalum_audio {
    type hw
    card 0                                 # Your audio card
}

ctl.opalum_audio {
    type opalum
    device "/dev/ttyUSB0"
}

# ===== Complete asym setup (playback + AVR control) =====
# For applications like shairport-sync
pcm.opalum_complete {
    type plug
    slave.pcm "hw:0"
}

ctl.opalum_complete {
    type opalum
    device "/dev/ttyUSB0"
    input "1"
}

# ===== OLD SYNTAX (unified plugin - for backwards compatibility) =====
# ctl.avr {
#     type avr
#     backend "opalum_serial"
#     device "/dev/ttyUSB0"
# }

# ===== Environment Variable Reference =====
# Set these before running ALSA commands:
#   export OPALUM_DEVICE=/dev/ttyUSB0
#   export OPALUM_INPUT=1
#   export OPALUM_LOG_FILE=/var/log/alsa-avr/opalum.log
#   export OPALUM_LOG_LEVEL=DEBUG

# ===== Opalum Input Numbers Reference =====
# Valid input numbers: 0, 1, 2, 3, 4
#   0 - Input 1
#   1 - Input 2
#   2 - Input 3
#   3 - Input 4
#   4 - Input 5

# ===== Serial Port Setup =====
# Add your user to the dialout group to access serial ports:
#   sudo usermod -a -G dialout $USER
#   # Log out and back in for changes to take effect
#
# Find your serial device:
#   ls -la /dev/ttyUSB*
#   ls -la /dev/ttyACM*
#
# Check which device is your USB-to-serial adapter:
#   dmesg | grep tty
