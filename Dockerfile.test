FROM debian:bookworm-slim

# Install ALSA libraries and tools
RUN apt-get update && apt-get install -y \
    alsa-utils \
    libasound2 \
    libasound2-plugins \
    && rm -rf /var/lib/apt/lists/*

# Create directories for plugins and logs
RUN mkdir -p /usr/lib/x86_64-linux-gnu/alsa-lib \
    && mkdir -p /var/log/alsa-avr \
    && mkdir -p /etc/alsa/conf.d

# Set up a test ALSA config
RUN echo "# Test configuration" > /etc/asound.conf

WORKDIR /test

CMD ["/bin/bash"]
