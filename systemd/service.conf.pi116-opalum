# Shairport Sync AVR Service Configuration
# Pi 116 (VærkstedsTærten) - Opalum Serial Control
# Copy this to /etc/shairport-sync-avr/service.conf on the target Pi

# Serial device to mount into the container (for serial-based backends)
# Leave empty if not using serial (e.g., for IP-based backends like Denon)
SERIAL_DEVICE_MOUNT=--device=/dev/ttyUSB0:/dev/ttyUSB0

# Plugin directory mount - mount the entire Docker plugin directory
# Plugins compiled for Alpine/musl are stored in /usr/local/lib/alsa-lib-docker/
# and mounted into the container at /usr/lib/alsa-lib/
PLUGIN_MOUNTS=-v /usr/local/lib/alsa-lib-docker:/usr/lib/alsa-lib:ro

# Shairport-sync command-line flags
# -o alsa: Use ALSA output
# -d hw:Headphones: PCM output device (actual audio hardware)
# -m opalum_serial:DEVICE,INPUT,LOG_FILE,LOG_LEVEL: Mixer device with parameters
# -c Master: Use "Master" mixer control for volume
# -vvv: Verbose logging (triple verbose)
# --statistics: Show statistics
SHAIRPORT_FLAGS=-vvv --statistics
