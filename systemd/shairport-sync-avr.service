[Unit]
Description=Shairport Sync AirPlay Audio Receiver with AVR Control
After=docker.service network-online.target sound.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# Load environment variables from config file
EnvironmentFile=/etc/shairport-sync-avr/service.conf

# Pull latest image before starting
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
ExecStartPre=-/usr/bin/docker pull mikebrady/shairport-sync:latest

# Run the container with configuration
# Mount /etc/alsa/conf.d/ for plugin definitions and local device configuration
# Note: We use /bin/sh -c to properly expand variables without word splitting issues
ExecStart=/bin/sh -c '/usr/bin/docker run --rm --name %n --net host --device /dev/snd ${SERIAL_DEVICE_MOUNT} -v /etc/alsa/conf.d:/etc/alsa/conf.d:ro -v /etc/shairport-sync-avr/shairport-sync.conf:/etc/shairport-sync.conf:ro -v /var/log/alsa-avr:/var/log/alsa-avr ${PLUGIN_MOUNTS} mikebrady/shairport-sync:latest ${SHAIRPORT_FLAGS}'

ExecStop=/usr/bin/docker stop -t 10 %n

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
