[Unit]
Description=Shairport Sync Docker
After=docker.service
Wants=network-online.target docker.socket
Requires=docker.socket

[Service]
TimeoutStartSec=0
Restart=always
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
ExecStartPre=-/usr/bin/docker pull shairport-sync-avr:latest
ExecStart=/usr/bin/docker run --rm --name %n \
  --net host \
  --device /dev/snd \
  --device /dev/ttyUSB0 \
  -v /etc/shairport-sync-avr/asound.conf:/etc/asound.conf:ro \
  -v /var/log/alsa-avr:/var/log/alsa-avr \
  shairport-sync-avr:latest \
  -vvv --statistics \
  -a StueTaerten -- -d avr -c AVR
ExecStop=/usr/bin/docker stop -t 10 %n

[Install]
WantedBy=multi-user.target
